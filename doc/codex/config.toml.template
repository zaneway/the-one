# Merge this block into ~/.codex/config.toml (or project-level Codex config).
# Placeholder __THEONE_REPO__ is replaced by install-codex.sh with the target project path.

[mcp_servers.theone]
command = "__THEONE_REPO__/bin/theone"
args = [
  "serve",
  "-config",
  "__THEONE_REPO__/theone.yaml",
  "-data-dir",
  "__THEONE_REPO__/.theone-data",
]
cwd = "__THEONE_REPO__"
startup_timeout_sec = 20
tool_timeout_sec = 120
enabled = true
required = false
