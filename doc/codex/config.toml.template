# Merge this block into ~/.codex/config.toml (or project-level Codex config).
# __THEONE_PACKAGE__ = release package directory; __THEONE_PROJECT__ = target project.

[mcp_servers.theone]
command = "__THEONE_PACKAGE__/bin/theone"
args = [
  "serve",
  "-config",
  "__THEONE_PACKAGE__/theone.yaml",
  "-data-dir",
  "__THEONE_PROJECT__/.theone-data",
]
cwd = "__THEONE_PACKAGE__"
startup_timeout_sec = 20
tool_timeout_sec = 120
enabled = true
required = false
