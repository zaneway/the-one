{
  "mcpServers": {
    "theone": {
      "command": "__THEONE_REPO__/bin/theone",
      "args": [
        "serve",
        "-config",
        "__THEONE_REPO__/theone.yaml",
        "-data-dir",
        "__THEONE_REPO__/.theone-data"
      ],
      "env": {
        "THEONE_DISABLE_PID": "1",
        "THEONE_LOG_PATH": "__THEONE_REPO__/.theone-data/logs/theone.log"
      }
    }
  }
}
